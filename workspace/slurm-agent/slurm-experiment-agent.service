[Unit]
Description=SLURM experiment result observer
After=default.target

[Service]
Type=simple
WorkingDirectory=/scratch/ehmoon/whlee/prefill-layer-alloc
ExecStart=/usr/bin/python3 /scratch/ehmoon/whlee/prefill-layer-alloc/workspace/slurm-agent/slurm_agent.py observe --poll 30
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
