+    def _get_gctx_decode_stream(self, n_sm: int):
+        # Cached green-ctx stream pinned to ~n_sm SMs (measurement of decode
+        # SM-sensitivity by layer type; the layer-aware premise).
+        if not hasattr(self, "_gctx_streams"):
+            self._gctx_streams = {}
