# Third-party clones — DO NOT vendor. Re-clone via reports/p0_triage.md §2.
external/

# Build / JIT caches and SLURM job logs (T5 harness)
**/.torch_ext/
**/.triton_cache/
*.out
*.err
*.zip

# Python bytecode — root ignores these but `!**/results/**` re-includes under
# results/; re-ignore here (deeper file wins) so analysis-script caches stay out.
**/__pycache__/
*.pyc

# (root .gitignore already ignores *.json, *.log, *.png, __pycache__, *.so)

# P1.4 temp markers
.nh_decode_sm_*
*.jid
.*_jid

# P1.4-1.6 runtime scratch: per-job decode-SM mode files + bench per-request dumps
.*_mode_*
.p17mode_*
.zbpx_*
.la_chk_*
*.jsonl

# keep engine-port env docs (root .gitignore ignores env/)
!env/
!env/**
