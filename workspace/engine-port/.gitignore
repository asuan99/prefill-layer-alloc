# Third-party clones — DO NOT vendor. Re-clone via reports/p0_triage.md §2.
external/

# Build / JIT caches and SLURM job logs (T5 harness)
**/.torch_ext/
**/.triton_cache/
**/.triton_cache*/
*.out
*.err
*.zip

# Python bytecode — root ignores these but `!**/results/**` re-includes under
# results/; re-ignore here (deeper file wins) so analysis-script caches stay out.
**/__pycache__/
*.pyc

# (root .gitignore already ignores *.json, *.log, *.png, __pycache__, *.so)

# P1.4 temp markers
.nh_decode_sm_*
*.jid
.*_jid

# P1.4-1.6 runtime scratch: per-job decode-SM mode files + bench per-request dumps
.*_mode_*
.p17mode_*
.zbpx_*
.la_chk_*
*.jsonl
*.log

# keep engine-port env docs (root .gitignore ignores env/)
!env/
!env/**

# p1_gates raw-dump policy (2026-08-06): raw serving artifacts follow the
# project-wide "harness + verdict tracked, raw not" convention above (the
# blanket *.jsonl/*.log/*.out/*.err rules already cover gate1's telemetry
# dumps, bench_serving JSONL, and SLURM stdout/stderr, and **/.triton_cache*/
# already covers the per-job Triton caches — see gate1_run.sbatch's own
# "same scope discipline as m3r2_pinforce.sbatch" note). Two narrow
# exceptions are carved back in because they are evidentiary, not raw: the
# Gate 1 server logs are cited by line number in reports/CONSENSUS.md
# (`gate1_srv_874478.log:32` is the partition-table citation), and the
# verify/ logs are the reproduction output substantiating the rev13 P1
# bootstrap-CI coverage correction — both are small, human-authored-scale
# outputs, not multi-MB per-request telemetry.
!results/p1_gates/gate1/gate1_srv_*.log
!results/p1_gates/verify/*.log

# Gate 2 (HOLB-probe 4-arm) raw-dump policy (2026-08-07), extending the
# 2026-08-06 gate1 policy above to gate2. Same "harness + verdict tracked,
# raw not" rule, evaluated file-by-file:
#   - report/result/correctness json + txt: tracked — these ARE the G3/G4/G5
#     verdict artifacts (g2_holb_analyze.py's scored output).
#   - flags_*.json (`/get_server_info` realized-vs-target dumps, PREREG_GATE2
#     section 1.2): tracked — this is the only record of the flags gate, no
#     other file substitutes for it, and it is small (~20KB/file).
#   - prompt_*.txt / prompt_meta_*.json: tracked — provenance for exactly
#     which prompt produced the G3 sha256 (small, human-scale).
#   - manifest_diff_holb_*.txt / runtime_source_manifest_holb_*.sha256:
#     tracked — same convention as the shared sync manifest above.
#   - *.raw.json (the raw HTTP call1/call2 responses behind the G3 sha256):
#     NOT tracked. The sha256 + PASS/FAIL is already recorded in
#     *_correctness_*.json; the raw response body is an intermediate
#     scratch artifact, not cited by line number anywhere, and reproducing
#     it means re-running the arm, not diffing a stored blob.
#   - *_srv_*.log: already excluded by the blanket *.log rule above (no
#     citation-by-line-number found in gate2 docs as of 2026-08-07, so no
#     exception carved back — contrast gate1's gate1_srv_*.log, which IS
#     cited). *.holb.jsonl / windows_*.jsonl / bench *.jsonl and
#     .triton_cache_*/ are likewise already excluded by existing rules
#     above; verified, no new rule needed for those.
!results/p1_gates/gate2/*_flags_*.json
!results/p1_gates/gate2/*_report_*.json
!results/p1_gates/gate2/*_correctness_*.json
results/p1_gates/gate2/*.raw.json
