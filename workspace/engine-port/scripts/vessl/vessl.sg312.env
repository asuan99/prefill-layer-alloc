# Launch env for Jobs on the py3.12 runtime image:  PDMUX_VESSL_ENV=workspace/engine-port/scripts/vessl/vessl.sg312.env scripts/vessl/launch.sh ...
# Identical to vessl.env except PDMUX_VESSL_IMAGE, which is the image launch.sh passes to the Job (the digest of PDMUX_VESSL_IMAGE_SG312).
# Non-secret VESSL Cloud settings for scripts/vessl/{launch,fetch}.sh.
# Copy to vessl.env in this directory and commit it once the slugs are known: it holds no
# secrets, and committing it makes every launch reproducible from the repo.
# Fill from real CLI output, never by guessing:
#   vesslctl resource-spec list --usable-only -o json   (A100 SXM 80GB x1, region us-west-2)
#   vesslctl volume list
PDMUX_VESSL_SPEC=resourcespec-a100x1        # VESSL A100 SXM x1, cluster-betelgeuse (us-west-2); full GPU only
PDMUX_VESSL_RATE_USD_H=1.48                 # hourlyCostInMicrocredit 1480000 (resource-spec list 2026-10-02); re-check
PDMUX_VESSL_CLUSTER_VOLUME="clustervol-havdzigstmv7"   # pdmux-cs, cluster-storage-0 (betelgeuse-na, us-west-2), team HybridLLM, mounted at /data
PDMUX_VESSL_OBJECT_VOLUME="objvol-9vgmwmerzwd3"       # pdmux-io, team HybridLLM, mounted at /io (code in, results out)
PDMUX_VESSL_IMAGE="ghcr.io/asuan99/sglang-py312-runtime@sha256:4414b5f98e43325848f3e15cfe40f05ba3d95d30463c3f30b9a8a557ded94a82"   # PUBLIC py3.12 runtime, same digest as the first py3.12 probe (23e0601)
PDMUX_VESSL_IMAGE_VLLM="ghcr.io/asuan99/vllm-runtime@sha256:57e5e7a9b1a173847648fb3786d4d0a02338c9687114e568688204ce28802c0a"   # pristine vLLM 0.31.0 (base vllm/vllm-openai@sha256:c1c9f6fd...); recipe de69d432 clean, pushed 2026-11-01; ghcr package must be PUBLIC
PDMUX_VESSL_IMAGE_SBASE="ghcr.io/asuan99/sglang-vllm-runtime@sha256:a5f9bf0f742de31f0de3f1cc2bc9fb352eec537dd4c746d9753d6d104087ea2b"   # (b') PUBLIC: sglang-runtime@1e0d335b (byte-unchanged) + /opt/vllm-venv (pristine vLLM 0.31.0); tag 0.31.0-09df5f34, recipe label 09df5f34 clean; ghcr package must be PUBLIC
PDMUX_VESSL_IMAGE_SG312="ghcr.io/asuan99/sglang-py312-runtime@sha256:4414b5f98e43325848f3e15cfe40f05ba3d95d30463c3f30b9a8a557ded94a82"   # PUBLIC sglang-vllm-runtime + /opt/sg312-venv (Python 3.12, pristine SGLang v0.5.10; recipe fa5fccb1)
