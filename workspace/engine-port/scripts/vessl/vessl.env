# Non-secret VESSL Cloud settings for scripts/vessl/{launch,fetch}.sh.
# Copy to vessl.env in this directory and commit it once the slugs are known: it holds no
# secrets, and committing it makes every launch reproducible from the repo.
# Fill from real CLI output, never by guessing:
#   vesslctl resource-spec list --usable-only -o json   (A100 SXM 80GB x1, region us-west-2)
#   vesslctl volume list
PDMUX_VESSL_SPEC=resourcespec-a100x1        # VESSL A100 SXM x1, cluster-betelgeuse (us-west-2); full GPU only
PDMUX_VESSL_RATE_USD_H=1.48                 # hourlyCostInMicrocredit 1480000 (resource-spec list 2026-10-02); re-check
PDMUX_VESSL_CLUSTER_VOLUME="clustervol-havdzigstmv7"   # pdmux-cs, cluster-storage-0 (betelgeuse-na, us-west-2), team HybridLLM, mounted at /data
PDMUX_VESSL_OBJECT_VOLUME="objvol-9vgmwmerzwd3"       # pdmux-io, team HybridLLM, mounted at /io (code in, results out)
PDMUX_VESSL_IMAGE="ghcr.io/asuan99/sglang-runtime@sha256:c85fc198c43e314567ec208efef51e49189ee861ca4d24e92c6c5035899b1456"   # PUBLIC, pristine SGLang; recipe e3bba8f, pushed 2026-10-02
