# Non-secret VESSL Cloud settings for scripts/vessl/{launch,fetch}.sh.
# Copy to vessl.env in this directory and commit it once the slugs are known: it holds no
# secrets, and committing it makes every launch reproducible from the repo.
# Fill from real CLI output, never by guessing:
#   vesslctl resource-spec list --usable-only -o json   (A100 SXM 80GB x1, region us-west-2)
#   vesslctl volume list
PDMUX_VESSL_SPEC=a100-sxm-1                 # full-GPU spec only (green context needs the whole GPU)
PDMUX_VESSL_RATE_USD_H=1.55                 # from resource-spec list at launch time; re-check
PDMUX_VESSL_CLUSTER_VOLUME="<clustervol-slug>" # pdmux-cs, us-west-2, mounted at /data
PDMUX_VESSL_OBJECT_VOLUME="<objectvol-slug>"   # pdmux-io, mounted at /io (code in, results out)
PDMUX_VESSL_IMAGE="<registry>/pdmux-sglang@sha256:<digest>"   # digest, never a tag
