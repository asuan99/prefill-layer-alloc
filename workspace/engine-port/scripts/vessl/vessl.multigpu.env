# Env file for the M1 multi-GPU probe launch (use: PDMUX_VESSL_ENV=<this file> launch.sh ...).
# Reason: launch.sh `source`s vessl.env, which would overwrite a PDMUX_VESSL_SPEC given in the caller's
# environment.  This file sources vessl.env, then restores the caller's PDMUX_VESSL_SPEC and sets the
# matching hourly rate from the table (resource-spec list 2026-10-12; re-check before submitting).
# A caller-supplied PDMUX_VESSL_RATE_USD_H wins.  Unknown spec without a rate -> empty rate -> launch.sh refuses.
_mp_spec="${PDMUX_VESSL_SPEC:-}"; _mp_rate="${PDMUX_VESSL_RATE_USD_H:-}"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/vessl.env"
if [[ -n "${_mp_spec}" ]]; then
  PDMUX_VESSL_SPEC="${_mp_spec}"; PDMUX_VESSL_RATE_USD_H="${_mp_rate}"
  if [[ -z "${PDMUX_VESSL_RATE_USD_H}" ]]; then
    case "${PDMUX_VESSL_SPEC}" in
      resourcespec-a100x1) PDMUX_VESSL_RATE_USD_H=1.48 ;;
      resourcespec-a100x2) PDMUX_VESSL_RATE_USD_H=2.96 ;;
      resourcespec-a100x4) PDMUX_VESSL_RATE_USD_H=5.92 ;;
      resourcespec-a100x8) PDMUX_VESSL_RATE_USD_H=11.84 ;;
      *) PDMUX_VESSL_RATE_USD_H="" ;;
    esac
  fi
fi
unset _mp_spec _mp_rate
