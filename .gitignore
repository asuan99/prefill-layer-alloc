# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/

# Virtualenv
env/
venv/
.venv/
bin/
lib/
lib64
include/
pyvenv.cfg
pip-wheel-metadata/
*.pth

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Test cache
.pytest_cache/

# Results & data
*.csv
*.json
# ...except the line-citation baseline: `--check` is meaningless without it, so
# a manifest that only ever lives on one machine makes the tool useless to the
# next session.  See scripts/discipline/check_line_citations.py.
!workspace/engine-port/scripts/discipline/line_citations.json
# ...and, for the same reason, the citation fingerprints of audit reports plus the
# scratch generators whose outputs those reports cite (2026-09-24): without them the
# audit's numbers and line citations cannot be re-derived on another machine.
!reports/audit/**/citations.json
!workspace/engine-port/scripts/discipline/presubmit_registry.json
*.pkl
*.pickle
*.parquet
*.npy
*.npz
*.h5
*.hdf5

# Plots & figures
*.png
*.pdf
*.svg
*.eps

# Triton kernel cache
.triton_cache/
**/.triton_cache/

# CUDA profiling artifacts
*.nsys-rep
*.ncu-rep
*.nvtx
*.sqlite
*.qdrep
*.nvvp
*.ptx
*.cubin

# Logs
*.log
logs/
runs/
wandb/

# SLURM output must live under a tracked experiment result directory.
/*.out
/*.err
/*.jsonl

# Model weights & checkpoints
*.pt
*.bin
*.safetensors
checkpoints/

# HuggingFace cache (모델 가중치·데이터셋, download_datasets.sh 산출물)
hf_cache/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temp
*.tmp
*.bak
scratch/
# exception (2026-09-24): scratch generators cited by audit/synthesis reports -- see the citations.json note above
!reports/audit/*/scratch/
!reports/audit/*/scratch/**
!reports/synthesis_*/scratch/
!reports/synthesis_*/scratch/**
tmp/

# Re-include experimental results
!results/
!results/**
!**/results/**
# Re-include v2 results (archived v1 lives under .../results/, already covered)
!results_v2/
!results_v2/**
!**/results_v2/**

# campaign runtime scratch (driver scripts, sentinels, jobid maps) — regenerable, not versioned
**/results/**/.campaign_drv.sh
**/results/**/.probe_drv.sh
**/results/**/.probe_ids_*.txt
**/results/**/*_DONE
**/results/**/STAGE1A_SELECTION.txt
**/results/**/manifest.tsv
**/results/**/manifest_1a.tsv
**/results/**/manifest_1b.tsv

# campaign runtime OUTPUTS — regenerable per run, provenance kept via each
# campaign's runtime_source_manifest.sha256 + its verdict/findings doc.
# (matches g2_0_*/stage0_xctrl practice: harness + verdict tracked, raw not)
**/results/**/*_result.txt
**/results/**/*_prompt.txt
**/results/**/*_prompt_[0-9]*.txt
**/results/**/smoke_prompt_*.txt
**/results/**/*_clocks.csv
# shared default sync manifest; the per-campaign copy is the tracked one
/workspace/engine-port/results/runtime_source_manifest.sha256

# transient job-monitoring logs (results/, not artifacts)
*_poll.log
*_rounds.jsonl.tmp

# 프로브 원자료 — telemetry는 크고(P4 TRACE_EVERY=1에서 337 MB) 재생성 가능
workspace/engine-port/results/longctx_conflict/probes/**/*telemetry.jsonl
workspace/engine-port/results/longctx_conflict/probes/**/.triton_cache/

# residency census 원자료 (2026-09-24) — 재생성 가능(같은 디렉터리 residency_census.py), 로컬 보관.
# 파일명 속 job ID·숫자 부분문자열이 check_citation_stops에 우연히 걸려 추적 불가로 결정(사용자, 2026-09-24).
workspace/engine-port/results/residency_census_2026-09-21/census_*.csv
workspace/engine-port/results/residency_census_2026-09-21/census_*.json
workspace/engine-port/results/residency_census_2026-09-21/file_list.txt
